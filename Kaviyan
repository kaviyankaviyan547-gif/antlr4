# Language Translator GUI Tool
from tkinter import *
from googletrans import Translator

def translate_text():
    translator = Translator()
    text = input_text.get("1.0", END).strip()
    src_lang = src_entry.get().strip()
    dest_lang = dest_entry.get().strip()

    if text and src_lang and dest_lang:
        try:
            translated = translator.translate(text, src=src_lang, dest=dest_lang)
            output_text.delete("1.0", END)
            output_text.insert(END, translated.text)
        except Exception as e:
            output_text.delete("1.0", END)
            output_text.insert(END, "Error: " + str(e))
    else:
        output_text.delete("1.0", END)
        output_text.insert(END, "Please enter text and language codes.")

# GUI Setup
root = Tk()
root.title("Language Translator Tool")
root.geometry("500x400")

Label(root, text="Enter Text:", font=("Arial", 12)).pack(pady=5)
input_text = Text(root, height=5, width=50)
input_text.pack()

frame = Frame(root)
frame.pack(pady=10)

Label(frame, text="From (e.g., en):").grid(row=0, column=0, padx=5)
src_entry = Entry(frame, width=10)
src_entry.grid(row=0, column=1, padx=5)

Label(frame, text="To (e.g., ta):").grid(row=0, column=2, padx=5)
dest_entry = Entry(frame, width=10)
dest_entry.grid(row=0, column=3, padx=5)

Button(root, text="Translate", command=translate_text, bg="blue", fg="white").pack(pady=10)

Label(root, text="Translated Text:", font=("Arial", 12)).pack(pady=5)
output_text = Text(root, height=5, width=50)
output_text.pack()

root.mainloop()
